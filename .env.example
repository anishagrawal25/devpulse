# Environment variables for DevPulse
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devpulse?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="devpulse-super-secret-jwt-key-32-chars-minimum-for-security"

# Google Gemini API Key (Optional: Can also be configured in Settings page or use smart fallback)
GEMINI_API_KEY=""

# Node Environment
NODE_ENV="development"
